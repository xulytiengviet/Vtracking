    <!-- Browser/OS chrome color. Default light; the inline script below swaps it
         pre-paint when the saved theme is dark. NOT brand blue — on Android the
         status bar paints this verbatim, and a saturated blue strip over the
         dark photo hero clashed with the page's paper/warm palette. -->
    <meta name="theme-color" content="#f2ece2" />
