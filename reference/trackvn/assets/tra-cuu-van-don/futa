    <script>
      // Apply theme before paint to avoid flash
      (function () {
        try {
          var t = localStorage.getItem('trackvn-theme');
          if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          }
          var l = localStorage.getItem('trackvn-lang');
          if (l) document.documentElement.lang = l;
          // Theme-matched browser chrome: keep the status bar on the app's own
          // surface color instead of a fixed hue (same swap AppShell does on toggle).
          // Dark uses #85898e — user-picked: a mid grey that sits INSIDE the
          // hero fog's tonal range, so the bar dissolves into the photo top
          // (see AppShell for the same constant).
          var tc = document.querySelector('meta[name="theme-color"]');
          if (tc && document.documentElement.classList.contains('dark')) {
            tc.setAttribute('content', '#85898e');
          }
        } catch (e) {}
      })();
    </script>
